# Existing PostgreSQL, runtime role only. URL-encode special characters in passwords.
DATABASE_URL=postgresql+psycopg://lifeos_app:CHANGE_ME@POSTGRES_HOST:5432/EXISTING_DATABASE
API_TOKEN=GENERATE_32_OR_MORE_RANDOM_CHARACTERS
# Lists/dicts use JSON, not comma-separated text.
ALLOWED_USER_IDS=[123]
ALLOWED_STREAM_IDS=[]
ZULIP_URL=https://YOUR_ZULIP_HOST
ZULIP_BOT_EMAIL=lifeos-bot@YOUR_ZULIP_HOST
ZULIP_API_KEY=CHANGE_ME
# Use a private VPN address or authenticated HTTPS. No hardcoded DGX addresses.
DGX_BASE_URL=https://YOUR_PRIVATE_DGX_HOST/v1
DGX_API_KEY=CHANGE_ME
DGX_MODEL=YOUR_SERVED_MODEL_NAME
DGX_PRIVATE_NETWORK=false
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=4096
MODEL_TIMEOUT_SECONDS=90
MODEL_RETRIES=2
MODEL_CONCURRENCY=2
STRUCTURED_OUTPUT_METHOD=json_schema
MODEL_INPUT_COST_PER_MILLION=0
MODEL_OUTPUT_COST_PER_MILLION=0
WORKER_CONCURRENCY=2
RUN_TIMEOUT_SECONDS=600
APPROVAL_TTL_HOURS=24
RATE_LIMIT_PER_MINUTE=10
MAX_ACTIVE_RUNS_PER_USER=5
ARTIFACT_ROOT=/data/artifacts
STORAGE_PROVIDER=local
S3_BUCKET=
# S3_ENDPOINT_URL=https://YOUR_S3_ENDPOINT
S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY only for S3 mode.
IMAGE_PROVIDER=none
IMAGE_BASE_URL=https://YOUR_IMAGE_PROVIDER/v1
IMAGE_API_KEY=
IMAGE_MODEL=YOUR_IMAGE_MODEL
TTS_PROVIDER=none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
MEDIA_TIMEOUT_SECONDS=180
SUBTITLE_FONT=Noto Sans Devanagari
RESEARCH_PROVIDER=none
# RESEARCH_URL=https://YOUR_RESEARCH_SERVICE/search
RESEARCH_TOKEN=
N8N_BASE_URL=https://YOUR_N8N_HOST
N8N_TOKEN=
N8N_WORKFLOWS={}
# Example: {"planning_reminder":"lifeos/planning-reminder","content_completed":"lifeos/content-completed"}
AIRFLOW_BASE_URL=https://YOUR_AIRFLOW_HOST/api/v2
AIRFLOW_TOKEN=
AIRFLOW_ALLOWED_DAGS=[]
# OTEL_EXPORTER_OTLP_ENDPOINT=http://YOUR_PRIVATE_COLLECTOR:4318
